{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "http-server",
        ".",
        "-p",
        "5500",
        "-c-1"
      ],
      "port": 5500
    },
    {
      "name": "web-local",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd web && PARITY_AUTH_BYPASS=1 TZ=America/Sao_Paulo npm run dev -- -p 3000"
      ],
      "port": 3000
    },
    {
      "name": "dashboard-py",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5500"
      ],
      "port": 5500
    }
  ]
}
