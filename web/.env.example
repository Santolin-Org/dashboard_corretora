# Template de variáveis de ambiente (sem segredos). Copie para .env.local.
DATABASE_URL=postgres://usuario:senha@host/banco
AUTH_SECRET=gere-com-openssl-rand-base64-32
AUTH_MICROSOFT_ENTRA_ID_ID=00000000-0000-0000-0000-000000000000
AUTH_MICROSOFT_ENTRA_ID_SECRET=segredo-do-registro-do-app
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/59190e65-5cad-4885-9f2d-77a59385667b/v2.0
# Só para o harness de paridade local; lança erro com VERCEL ou NODE_ENV=production.
# PARITY_AUTH_BYPASS=1
# Só se rodar 'next start' fora da Vercel (localhost):
# AUTH_TRUST_HOST=true
