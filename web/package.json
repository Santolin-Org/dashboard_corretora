{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "parity": "TZ=America/Sao_Paulo tsx parity/run.ts",
    "test:parity": "TZ=America/Sao_Paulo playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/server/db/seed.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "regressao": "npm run lint && npm run typecheck && npm test && npm run test:tz && npm run test:parity",
    "regressao:real": "echo \"disponível a partir da Task 12\"",
    "test:tz": "TZ=UTC vitest run tests/domain && TZ=America/Sao_Paulo vitest run tests/domain"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "chart.js": "4.4.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
