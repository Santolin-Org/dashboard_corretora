{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "parity": "TZ=America/Sao_Paulo tsx parity/run.ts",
    "test:parity": "TZ=America/Sao_Paulo playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "regressao": "npm run lint && npm run typecheck && npm test && npm run test:tz",
    "regressao:real": "echo \"disponível a partir da Task 12\"",
    "test:tz": "TZ=UTC vitest run tests/domain/datas.test.ts && TZ=America/Sao_Paulo vitest run tests/domain/datas.test.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
