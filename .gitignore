# ── Segredos / configuração local — NUNCA versionar ──
.env
# (o .env.example, que é só template, continua versionado)

# ── Logs ──
*.log

# ── Cache de dados baixados do SharePoint (planilhas de produção) ──
cache/
scripts/cache/

# ── Backups locais ──
backup_*/

# ── Python ──
__pycache__/
*.pyc
.venv/
venv/

# ── Config local do editor / Claude ──
.claude/settings.local.json
.claude/skills/
.idea/

# ── Arquivos de sistema operacional ──
Thumbs.db
.DS_Store
desktop.ini

# ── App Next.js (web/) ──
web/parity/data/
web/parity/.golden/
web/.env*.local
web/seed/usuarios.json

